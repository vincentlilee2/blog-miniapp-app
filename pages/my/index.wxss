.page-my {
  min-height: 100vh;
  background: #f5f6f8;
  padding-bottom: 60rpx;
}

.state-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 60rpx;
  gap: 24rpx;
}
.state-tip {
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.45);
  text-align: center;
}

/* ① 身份条（浅色页面里的深色点缀） */
.id-bar {
  display: flex;
  align-items: center;
  gap: 22rpx;
  background: linear-gradient(135deg, #0e2233, #123a5c);
  margin: 20rpx 24rpx;
  border-radius: 16rpx;
  padding: 26rpx 28rpx;
}
.id-bar--hover {
  opacity: 0.92;
}
.id-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.8);
  flex-shrink: 0;
  background: #1b4367;
}
.id-avatar--empty {
  display: flex;
  align-items: center;
  justify-content: center;
}
.id-text {
  flex: 1;
  min-width: 0;
}
.id-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
}
.id-role {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.65);
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ② 内容浏览 / ④ 关于 */
.card-sec {
  background: #fff;
  border-radius: 16rpx;
  margin: 0 24rpx 20rpx;
  padding: 8rpx 28rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}
.nav-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}
.nav-row:last-child {
  border-bottom: none;
}
.nav-row--hover {
  background: #f7f8fa;
}
.nav-icon {
  font-size: 40rpx;
  line-height: 1;
}
.nav-main {
  flex: 1;
  min-width: 0;
}
.nav-title {
  font-size: 29rpx;
  font-weight: 600;
  color: rgba(0, 0, 0, 0.88);
}
.nav-sub {
  font-size: 22rpx;
  color: rgba(0, 0, 0, 0.4);
  margin-top: 4rpx;
}

/* ③ 给我留言主按钮 */
.gb-cta {
  margin: 0 24rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #d4af37, #f0d488);
  border-radius: 999rpx;
  padding: 24rpx 0;
  box-shadow: 0 4rpx 14rpx rgba(212, 175, 55, 0.35);
}
.gb-cta--hover {
  opacity: 0.9;
}
.gb-cta-icon {
  font-size: 32rpx;
}
.gb-cta-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #0e2233;
}

/* ④ 关于 */
.sec-title {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(0, 0, 0, 0.4);
  letter-spacing: 2rpx;
  padding: 22rpx 0 4rpx;
}
.about-name {
  font-size: 29rpx;
  font-weight: 600;
  margin-top: 10rpx;
}
.about-desc {
  font-size: 23rpx;
  color: rgba(0, 0, 0, 0.5);
  margin-top: 8rpx;
  line-height: 1.6;
}
.about-links {
  margin-top: 14rpx;
}
.link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}
.link-row:last-child {
  border-bottom: none;
}
.link-label {
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.8);
  flex: 1;
  margin-right: 16rpx;
}
.link-copy {
  font-size: 22rpx;
  color: #0052d9;
  flex-shrink: 0;
}
.about-meta {
  font-size: 21rpx;
  color: rgba(0, 0, 0, 0.35);
  padding: 10rpx 0 22rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}
.about-meta-dot {
  margin: 0 8rpx;
}

.page-foot {
  text-align: center;
  font-size: 21rpx;
  color: rgba(0, 0, 0, 0.3);
  padding-top: 10rpx;
}
