.page-my {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

.state-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 60rpx;
  gap: 24rpx;
}
.state-tip {
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.45);
  text-align: center;
}

/* 作者卡 */
.author-card {
  background: linear-gradient(160deg, #0b1f3a 0%, #12315c 60%, #0052d9 130%);
  padding: 60rpx 40rpx 48rpx;
  display: flex;
  gap: 28rpx;
}
.author-avatar {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.85);
  flex-shrink: 0;
  background: #fff;
}
.author-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.author-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}
.author-role {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 6rpx;
}
.author-bio {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.6;
  margin-top: 14rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}
.author-socials {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}
.social-chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
  font-size: 22rpx;
  color: #fff;
}
.social-chip--cta {
  background: #d4af37;
  color: #0e2233;
  font-weight: 600;
}

/* 分区 */
.section {
  background: #fff;
  margin: 24rpx;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(0, 0, 0, 0.85);
  margin-bottom: 20rpx;
}

/* 微信 */
.wechat-box {
  display: flex;
  align-items: center;
  gap: 28rpx;
}
.wechat-qr {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
  background: #f6f6f6;
  flex-shrink: 0;
}
.wechat-id {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.85);
}
.wechat-copy {
  font-size: 22rpx;
  color: #0052d9;
}

/* 项目 */
.project-list {
  display: flex;
  flex-direction: column;
}
.project-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}
.project-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}
.project-name {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(0, 0, 0, 0.88);
}
.project-desc {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.5);
  line-height: 1.6;
  margin-top: 8rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.page-foot {
  text-align: center;
  font-size: 22rpx;
  color: rgba(0, 0, 0, 0.3);
  padding-top: 20rpx;
}
.page-my { padding-bottom: 130rpx; }
