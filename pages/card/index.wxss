.card-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #0e2233 0%, #123a5c 30%, #0e2233 100%);
  padding: 20rpx 40rpx 60rpx;
  box-sizing: border-box;
  color: #fff;
}

.state-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 60rpx;
  gap: 24rpx;
}
.state-tip {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  text-align: center;
}

/* 品牌字标 */
.brand {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 16rpx 0 8rpx;
}
.brand-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #d4af37;
}
.brand-text {
  font-size: 30rpx;
  letter-spacing: 4rpx;
  color: #e8d9a8;
  font-weight: 500;
}

/* 首屏：头像左 文字右 */
.hero {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 36rpx;
  padding: 40rpx 20rpx 48rpx;
}
.hero-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.avatar-wrap {
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  padding: 6rpx;
  background: linear-gradient(135deg, #d4af37, #f6e7b2, #d4af37);
  flex-shrink: 0;
}
.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
  background: #1b4367;
  overflow: hidden;
}
.avatar--empty {
  display: flex;
  align-items: center;
  justify-content: center;
}
.hero-name {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.hero-role {
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 12rpx;
  text-align: left;
  line-height: 1.5;
}
.hero-sub {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.55);
  margin-top: 10rpx;
  text-align: left;
  line-height: 1.6;
}

/* 分区标题 */
.divider {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  font-size: 22rpx;
  letter-spacing: 3rpx;
  color: rgba(255, 255, 255, 0.5);
  margin: 24rpx 0 20rpx;
}
.divider-line {
  width: 60rpx;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.25);
}

/* 作品 */
.projects {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.proj {
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 14rpx;
  padding: 24rpx 26rpx;
}
.proj-name {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.proj-name-text {
  font-size: 28rpx;
  font-weight: 600;
  flex: 1;
}
.proj-badge {
  font-size: 18rpx;
  color: #d4af37;
  border: 1rpx solid rgba(212, 175, 55, 0.5);
  border-radius: 6rpx;
  padding: 0 8rpx;
  flex-shrink: 0;
}
.proj-desc {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.6;
  margin-top: 10rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 社交 */
.socials {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.soc {
  font-size: 24rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
  padding: 10rpx 32rpx;
}
.soc--cta {
  background: linear-gradient(135deg, #d4af37, #f0d488);
  border-color: transparent;
  color: #0e2233;
  font-weight: 600;
}

/* 微信 */
.wechat {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.wechat-hint {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 20rpx;
}
.qr-row {
  display: flex;
  gap: 32rpx;
}
.qr-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.qr-box {
  width: 216rpx;
  height: 216rpx;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.qr-img {
  width: 100%;
  height: 100%;
}
.qr-empty {
  font-size: 20rpx;
  color: #999;
  text-align: center;
  line-height: 1.6;
  padding: 0 10rpx;
}
.qr-cap {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.65);
  margin-top: 12rpx;
}
.wechat-id {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 28rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 999rpx;
  padding: 10rpx 28rpx;
}
.wechat-copy {
  font-size: 22rpx;
  color: #8fc7ff;
}

.card-foot {
  text-align: center;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.35);
  margin-top: 48rpx;
  letter-spacing: 2rpx;
}
