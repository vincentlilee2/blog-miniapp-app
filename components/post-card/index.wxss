.post-card {
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.15s ease;
}
.post-card--hover {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 有封面：图上文下 */
.post-card__cover {
  width: 100%;
  height: 340rpx;
  display: block;
  background: #e8e8e8;
}

.post-card__body {
  padding: 24rpx 28rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

/* 无封面：标题加粗置顶，类文章形态 */
.post-card--cover .post-card__title {
  font-size: 32rpx;
}
.post-card__title {
  font-size: 34rpx;
  font-weight: 600;
  color: rgba(0, 0, 0, 0.9);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.post-card__desc {
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.5);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.post-card__footer {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.post-card__meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}
.post-card__date {
  font-size: 22rpx;
  color: rgba(0, 0, 0, 0.35);
  margin-right: 12rpx;
}
.post-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.post-card__tag {
  font-size: 20rpx;
  color: #0052d9;
  background: rgba(0, 82, 217, 0.08);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}
.post-card__more {
  font-size: 24rpx;
  color: #0052d9;
  flex-shrink: 0;
  margin-left: 16rpx;
}
